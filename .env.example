DJANGO_SECRET_KEY=replace-with-a-strong-secret-use-python-secrets-token-urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database: sqlite3 (default) or postgresql
DJANGO_DB_ENGINE=sqlite3
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=site_app
# DJANGO_DB_USER=postgres
# DJANGO_DB_PASSWORD=your-db-password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Email (console backend in dev; use SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional Razorpay keys for future payment gateway integration
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
